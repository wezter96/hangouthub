# URL the app uses to reach the API.
# Use your machine's LAN IP when running on a physical device, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Set to "true" once OAuth providers are configured on the server to show the
# "continue with GitHub/Google" buttons.
# EXPO_PUBLIC_ENABLE_SOCIAL=true
