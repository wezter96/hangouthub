# Postgres connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/hangouthub

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32+-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Allowed browser origin for the web build
CORS_ORIGIN=http://localhost:8081
